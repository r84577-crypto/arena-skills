# متغيّرات البيئة — لا تضع أي قيمة حقيقية هنا. انسخ إلى .env.local واملأها.
#
#   cp .env.example .env.local

## عامة (تصل إلى المتصفح — المفتاح العام فقط، لا أسرار)
NEXT_PUBLIC_SUPABASE_URL=https://hkgdtybmlrgbvakjgrxl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## خادم فقط (بلا بادئة NEXT_PUBLIC_ — لا تصل إلى المتصفح أبداً)
# إرسال الإيميل عبر Resend. بدونها يجيب المسار not_configured بصدق.
RESEND_API_KEY=
# عنوان المرسل. للتجربة يعمل onboarding@resend.dev، وللإنتاج وثّق نطاقك.
RESEND_FROM=onboarding@resend.dev
# إرسال الواتساب عبر WhatsApp Business Cloud API. بدونها not_configured.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

## ممنوع منعاً قاطعاً في هذه الواجهة
# SUPABASE_SERVICE_ROLE_KEY — يتجاوز RLS. لا حاجة له هنا أصلاً:
# التحقق يتم برمز جلسة المالك، والكتابة تحكمها سياسات RLS.
