# متغيّرات البيئة — لا تضع أي قيمة حقيقية هنا. انسخ إلى .env.local واملأها.
#
#   cp .env.example .env.local
#
# ⚠️ القاعدة الوحيدة: أي متغيّر يبدأ بـ NEXT_PUBLIC_ يعيش في حزمة المتصفح
# ويمكن لأي زائر قراءته. لا سرّ يحمل هذه البادئة، أبداً. الفحص الآلي
# لهذه القاعدة موجود في scripts/check-env-exposure.py ويعمل في CI.

## عامة (تصل إلى المتصفح — المفتاح العام فقط، لا أسرار)
NEXT_PUBLIC_SUPABASE_URL=https://hkgdtybmlrgbvakjgrxl.supabase.co
# المفتاح العام (anon/publishable). آمن للنشر بالتصميم، وRLS هو الحارس.
# لا تضع SUPABASE_SERVICE_ROLE_KEY هنا ولا في أي متغيّر NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## خادم فقط (بلا بادئة NEXT_PUBLIC_ — لا تصل إلى المتصفح أبداً)
# إرسال الإيميل: Resend أولاً (3000 رسالة/شهر مجاناً)، وإلا Gmail SMTP.
# بدون أي منهما يجيب المسار not_configured بصدق — لكن بعد التحقق من الجلسة.
RESEND_API_KEY=
# عنوان المرسل. للتجربة يعمل onboarding@resend.dev (لبريدك فقط)، وللغير وثّق نطاقك.
RESEND_FROM=onboarding@resend.dev
# البديل المجاني الكامل: بريد Gmail + كلمة مرور التطبيقات
# (myaccount.google.com/apppasswords — تتطلب التحقق بخطوتين).
# يرسل لأي مستلم بحدود Gmail اليومية المعتادة (~500 رسالة/يوم).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# إرسال الواتساب عبر WhatsApp Business Cloud API. بدونها not_configured.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

## الأصل (CSRF)
# أصول إضافية مسموحة للطلبات المتقاطعة، مفصولة بفواصل. الافتراضي لا شيء:
# الموقع يقبل مطابقة مضيفه فقط. أضف نطاق المعاينة إن كنت تستخدمه:
#   ALLOWED_ORIGINS=https://alfao.netlify.app,https://preview--alfao.netlify.app
ALLOWED_ORIGINS=
# أصل الموقع الرسمي (يُستخدم في الروابط وفي ترويسة CSP عند الحاجة).
#   SITE_ORIGIN=https://alfao.netlify.app
SITE_ORIGIN=

## ممنوع منعاً قاطعاً في هذه الواجهة
# SUPABASE_SERVICE_ROLE_KEY — يتجاوز RLS. لا حاجة له هنا أصلاً:
# التحقق يتم برمز جلسة المالك، والكتابة تحكمها سياسات RLS.
#
# تحقّق قبل النشر:
#   python3 ../scripts/check-env-exposure.py
